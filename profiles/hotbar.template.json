{
  "schema": 1,
  "name": "通用骨架",
  "game_class": "",
  "description": "空白开局太难上手，所以给了这份骨架：8 个技能格 → 按键 1-8，优先级从上到下。坐标是 1920×1080 的占位值，颜色全是待取（容差 0 = 永不命中），所有规则默认关闭，所以直接启动它不会乱按。流程：一键铺点重铺坐标 → 把游戏摆成想触发的样子 → 学色 → 勾上启用。",
  "settings": {
    "tick_ms": 10,
    "key_hold_ms": 30,
    "key_interval_ms": 50,
    "jitter_ms": 0,
    "require_foreground": true,
    "capture_mode": "desktop",
    "scale_with_resolution": true,
    "anchor_mode": "client",
    "window_title": "",
    "window_class": "",
    "reference_size": [
      1920,
      1080
    ]
  },
  "hotkeys": {
    "toggle": {
      "key": "q",
      "modifiers": [
